{% comment %}
  Renders "Questions about this guitar?" — a type-your-own field, plus
  optional one-tap starter questions, sent straight into Shopify Inbox as a
  live chat.

  At $3,000+ the willingness to answer a stranger directly is itself the trust
  signal. Deliberately does NOT offer a live video walkthrough: only promise
  what can reliably be delivered, because an offer that goes unanswered does
  more damage at this price than never making it.

  Accepts:
  - product: {Object} Product liquid object
  - block:   {Object} The ask_block block

  STARTER QUESTIONS — SWITCHED OFF
  Up to four one-tap questions can sit above the field; a tap sends at once,
  like the suggestion pills inside Shopify's own chat. They are off (all four
  settings empty): shoppers tapped them instead of reading the description,
  which already answers most of them, so they mostly produced questions that
  had been answered. Filling them in again in the theme editor brings them
  back — the markup below and the JS still support them.

  Sending, the guitar title attached to every message, and all fallbacks live
  in assets/aeonic-product.js. The block is marked .aeonic-chat-only, so it
  stays hidden unless Shopify's chat is actually on the page.
{% endcomment %}

{%- liquid
  assign s = block.settings
  assign heading_id = 'AeonicAskHeading-' | append: block.id
-%}

<div
  class="aeonic-ask aeonic-chat-only"
  data-aeonic-ask
  data-product-title="{{ product.title | escape }}"
  {{ block.shopify_attributes }}
>
  {%- if s.heading != blank -%}
    <p class="aeonic-ask__heading" id="{{ heading_id }}">{{ s.heading }}</p>
  {%- endif -%}

  {%- capture starter_buttons -%}
    {%- for i in (1..4) -%}
      {%- liquid
        assign key = 'starter_' | append: i
        assign question = s[key]
      -%}
      {%- if question != blank -%}
        <button type="button" class="aeonic-ask__starter" data-aeonic-starter="{{ question | escape }}">
          {{- question | escape -}}
        </button>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if starter_buttons != blank -%}
    <div
      class="aeonic-ask__starters"
      role="group"
      {% if s.heading != blank %}aria-labelledby="{{ heading_id }}"{% else %}aria-label="Common questions"{% endif %}
    >
      {{- starter_buttons -}}
    </div>
  {%- endif -%}

  <form class="aeonic-ask__form" data-aeonic-ask-form novalidate>
    <label class="visually-hidden" for="AeonicAsk-{{ block.id }}">
      {{- s.input_placeholder | default: 'Ask your own question' -}}
    </label>
    <input
      id="AeonicAsk-{{ block.id }}"
      class="aeonic-ask__input"
      type="text"
      name="question"
      placeholder="{{ s.input_placeholder | default: 'Ask your own question…' | escape }}"
      maxlength="300"
      autocomplete="off"
      enterkeyhint="send"
    >
    <button type="submit" class="aeonic-ask__send" aria-label="Send question">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 8h10M9 4l4 4-4 4"/>
      </svg>
    </button>
  </form>

  {%- if s.footnote != blank -%}
    <p class="aeonic-ask__note">{{ s.footnote }}</p>
  {%- endif -%}
</div>

{%- style -%}
  .aeonic-ask {
    margin: 1.6rem 0;
    padding: 1.4rem 1.6rem;
    border: 1px solid rgba(var(--color-foreground), 0.12);
    border-radius: 8px;
    background: rgba(var(--color-foreground), 0.02);
  }

  .aeonic-ask__heading {
    margin: 0 0 1rem;
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.4;
    color: rgb(var(--color-foreground));
  }

  .aeonic-ask__starters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .aeonic-ask__starter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 40px;
    padding: 0.6rem 1.3rem;
    border: 1px solid rgba(var(--color-foreground), 0.22);
    border-radius: 999px;
    background: transparent;
    font-family: inherit;
    font-size: 1.3rem;
    line-height: 1.3;
    text-align: left;
    color: rgb(var(--color-foreground));
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease, opacity 0.15s ease;
  }

  .aeonic-ask__starter:hover:not(:disabled) {
    border-color: rgb(var(--color-foreground));
  }

  .aeonic-ask__starter.is-busy {
    opacity: 0.55;
    cursor: progress;
  }

  /* Already asked: confirm it went, and stop it looking like an open invitation
     to send the same question twice. */
  .aeonic-ask__starter.is-sent {
    border-color: rgba(46, 160, 77, 0.5);
    background: rgba(46, 160, 77, 0.06);
  }

  .aeonic-ask__starter.is-sent::before {
    content: '\2713';
    font-weight: 700;
    color: #2ea04d;
  }

  .aeonic-ask__form {
    display: flex;
    gap: 0.7rem;
    margin: 0;
  }

  .aeonic-ask__starters + .aeonic-ask__form {
    margin-top: 1rem;
  }

  .aeonic-ask__input {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 44px;
    padding: 0 1.2rem;
    border: 1px solid rgba(var(--color-foreground), 0.25);
    border-radius: 6px;
    background: rgb(var(--color-background));
    font-family: inherit;
    font-size: 1.6rem; /* 16px+ stops iOS zooming the page on focus */
    color: rgb(var(--color-foreground));
  }

  .aeonic-ask__input:focus {
    outline: none;
    border-color: rgb(var(--color-foreground));
    box-shadow: 0 0 0 1px rgb(var(--color-foreground));
  }

  .aeonic-ask__send {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(var(--color-foreground), 0.25);
    border-radius: 6px;
    background: transparent;
    color: rgb(var(--color-foreground));
    cursor: pointer;
    transition: border-color 0.15s ease, opacity 0.15s ease;
  }

  .aeonic-ask__send:hover:not(:disabled) {
    border-color: rgb(var(--color-foreground));
  }

  .aeonic-ask__send.is-busy {
    opacity: 0.55;
    cursor: progress;
  }

  .aeonic-ask__send svg {
    width: 16px;
    height: 16px;
  }

  .aeonic-ask__note {
    margin: 0.9rem 0 0;
    font-size: 1.2rem;
    line-height: 1.5;
    color: rgba(var(--color-foreground), 0.55);
  }
{%- endstyle -%}
