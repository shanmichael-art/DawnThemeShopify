{% comment %}
  Renders the shop-level reputation line that sits immediately under the price.

  WHY SHOP-LEVEL AND NOT PRODUCT-LEVEL
  Every guitar here is a one-of-one, so a product-level review widget can only
  ever say "0 reviews" or "1 review" — which reads as *worse* than saying
  nothing at all right at the moment someone is deciding to send four figures to
  an unfamiliar site. The reputation that matters (hundreds of buyers, thousands
  of guitars) lives at the shop level, so that is what belongs beside the price.
  The full per-product review widget still renders further down the page.

  Deliberately carries only reputation — rating and guitars sold. Shipping
  speed and insurance are stated by the value stack immediately below this
  (its "Insured shipping / flat rate, signature required" line and the live
  delivery estimate), and repeating them two rows apart reads as padding
  rather than proof.

  Accepts:
  - block: {Object} The trust_strip block

  Both items are independently blank-safe — clear a setting and that item
  disappears rather than leaving an empty separator.
{% endcomment %}

{%- liquid
  assign s = block.settings

  assign has_rating = false
  if s.rating_value != blank and s.rating_count != blank
    assign has_rating = true
  endif
-%}

{%- if has_rating or s.sold_count != blank -%}
  <ul class="aeonic-trust" {{ block.shopify_attributes }}>
    {%- if has_rating -%}
      {%- capture rating_content -%}
        <span class="aeonic-trust__stars" aria-hidden="true">
          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 1.6l1.94 3.93 4.34.63-3.14 3.06.74 4.32L8 11.5l-3.88 2.04.74-4.32L1.72 6.16l4.34-.63z"/>
          </svg>
        </span>
        <strong>{{ s.rating_value }}</strong>
        <span class="aeonic-trust__muted">
          from {{ s.rating_count }} verified {% if s.rating_count == '1' %}buyer{% else %}buyers{% endif %}
        </span>
      {%- endcapture -%}
      <li class="aeonic-trust__item aeonic-trust__item--rating">
        {%- if s.rating_link != blank -%}
          <a href="{{ s.rating_link }}">{{ rating_content }}</a>
        {%- else -%}
          {%- comment -%}
            No explicit link set, so let the strip find the review widget itself.
            The obvious anchor — the reviews section's DOM id — is template-scoped
            (shopify-section-template--NNNN__xxxx) and changes with the theme, so
            hardcoding it would silently rot. Rendered as a plain span and only
            upgraded to something clickable once a widget is actually found.
          {%- endcomment -%}
          <span data-aeonic-reviews-jump>{{ rating_content }}</span>
        {%- endif -%}
      </li>
    {%- endif -%}

    {%- if s.sold_count != blank -%}
      <li class="aeonic-trust__item">
        <strong>{{ s.sold_count }}</strong>
        <span class="aeonic-trust__muted">guitars sold</span>
      </li>
    {%- endif -%}

  </ul>

  <script>
    (function () {
      if (window.__aeonicTrustBound) return;
      window.__aeonicTrustBound = true;

      var WIDGET = '.jdgm-rev-widg, .jdgm-widget, .jdgm-review-widget, [data-judgeme], .spr-reviews';

      function target() {
        return document.querySelector(WIDGET);
      }

      // Only make the rating clickable once there is somewhere for it to go.
      // A link that scrolls nowhere is worse than plain text here.
      function upgrade() {
        if (!target()) return false;
        var els = document.querySelectorAll('[data-aeonic-reviews-jump]:not([data-upgraded])');
        for (var i = 0; i < els.length; i++) {
          els[i].setAttribute('data-upgraded', '1');
          els[i].setAttribute('role', 'link');
          els[i].setAttribute('tabindex', '0');
          els[i].classList.add('aeonic-trust__jump');
        }
        return true;
      }

      function jump() {
        var el = target();
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      // Delegated: survives Dawn's innerHTML re-render on variant change.
      document.addEventListener('click', function (e) {
        if (e.target.closest('[data-aeonic-reviews-jump][data-upgraded]')) jump();
      });
      document.addEventListener('keydown', function (e) {
        if ((e.key === 'Enter' || e.key === ' ') && e.target.closest('[data-aeonic-reviews-jump][data-upgraded]')) {
          e.preventDefault();
          jump();
        }
      });

      // Judge.me injects its widget well after DOMContentLoaded.
      if (!upgrade()) {
        var tries = 0;
        var poll = setInterval(function () {
          if (upgrade() || ++tries > 20) clearInterval(poll);
        }, 500);
      }
      document.addEventListener('shopify:section:load', upgrade);
    })();
  </script>
{%- endif -%}

{%- style -%}
  .aeonic-trust {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.4rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .aeonic-trust__item {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 1.3rem;
    line-height: 1.4;
    color: rgb(var(--color-foreground));
  }

  /* Separator between items, but never a trailing one. */
  .aeonic-trust__item + .aeonic-trust__item::before {
    content: '';
    display: block;
    width: 3px;
    height: 3px;
    margin-right: 0.95rem;
    border-radius: 50%;
    background: rgba(var(--color-foreground), 0.28);
  }

  .aeonic-trust__item strong {
    font-weight: 700;
  }

  .aeonic-trust__muted {
    color: rgba(var(--color-foreground), 0.6);
  }

  .aeonic-trust__item--rating a,
  .aeonic-trust__item--rating .aeonic-trust__jump {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.25);
  }

  .aeonic-trust__item--rating a:hover,
  .aeonic-trust__item--rating .aeonic-trust__jump:hover {
    border-bottom-color: rgb(var(--color-foreground));
  }

  /* Un-upgraded rating (no review widget found) stays inert text. */
  .aeonic-trust__item--rating > span:not(.aeonic-trust__jump) {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .aeonic-trust__stars {
    display: inline-flex;
  }

  .aeonic-trust__stars svg {
    width: 14px;
    height: 14px;
    color: #e7cc87;
  }
{%- endstyle -%}
